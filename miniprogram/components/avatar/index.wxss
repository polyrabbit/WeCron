:host {
  display: inline-flex;
  flex-shrink: 0;
}

.avatar-image,
.avatar-letter {
  border-radius: 50%;
  flex-shrink: 0;
}

.avatar-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 500;
  line-height: 1;
  box-sizing: border-box;
  user-select: none;
}
