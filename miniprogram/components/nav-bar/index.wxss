.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background-color: #387ef5;
  color: #fff;
}

.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  /* Centre the title in the space left of the capsule button */
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-back {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back-hover {
  opacity: 0.6;
}
.nav-back-icon {
  width: 44rpx;
  height: 44rpx;
  transform: rotate(180deg);
}
